# A fixed release tag is required. Never use :latest in production.
APP_IMAGE=ghcr.io/ywainzh/sub2api:release-YYYY.MM.DD-N
BIND_HOST=127.0.0.1
HOST_PORT=39080

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
POSTGRES_DB=sub2api
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5

REDIS_IMAGE=redis:8-alpine
REDIS_PASSWORD=
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNS=4

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
TZ=Asia/Shanghai
